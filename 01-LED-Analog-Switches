// A system of 2 switches that control the brightness of a red LED using an ESP32 microcontroller and the Arduino IDE.

#define LEDpin 2
int brightness 155 // Initial brightness of the LED
#define switchHigh 18
#define switchLow 19

void setup() {
  // put your setup code here, to run once:
pinMode(LEDpin, OUTPUT);
pinMode(switchHigh, INPUT_PULLUP);
pinMode(switchLow, INPUT_PULLUP);
}

void loop() {
  // put your main code here, to run repeatedly:
delay(10);
analogWrite(LEDpin, brightness);


}

